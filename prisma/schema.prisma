generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DataStore {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}


// ─── Business OS: ventures, CRM, pipeline, playbooks ─────────────
// A Venture is one revenue stream (e.g. CandidateHub, web projects, AI consulting).
// It is config, not code: an ordered list of pipeline stages plus playbooks.
// Company/Contact are shared across ventures so one prospect can be cross-sold.

model Venture {
  key       String     @id                 // slug, e.g. "candidatehub"
  name      String
  stages    String[]                       // ordered open stages, e.g. ["prospect","contacted",...]
  wonStage  String     @default("won")
  lostStage String     @default("lost")
  recurring Boolean    @default(false)     // true → won deals count toward MRR (valueCents is monthly)
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())
  deals     Deal[]
  playbooks Playbook[]
}

model Company {
  id        String    @id @default(cuid())
  name      String
  website   String?
  industry  String?
  size      String?                        // free text, e.g. "50-200"
  location  String?
  source    String?                        // where the lead came from
  notes     String?
  tags      String[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  contacts  Contact[]
  deals     Deal[]

  @@index([name])
}

model Contact {
  id             String    @id @default(cuid())
  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  name           String
  email          String?
  title          String?
  linkedinUrl    String?
  // CASL (Canada's anti-spam law) consent basis for commercial electronic messages:
  // none | express | implied_existing | implied_conspicuous (published address, relevant to their role)
  consentBasis   String    @default("none")
  consentNote    String?
  unsubscribedAt DateTime?
  lastTouchedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deals          Deal[]

  @@index([companyId])
  @@index([email])
}

model Deal {
  id             String    @id @default(cuid())
  ventureKey     String
  venture        Venture   @relation(fields: [ventureKey], references: [key])
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title          String
  stage          String
  valueCents     Int       @default(0)     // one-off price, or monthly price when venture.recurring
  currency       String    @default("CAD")
  nextAction     String?
  nextActionDue  DateTime?
  stageChangedAt DateTime  @default(now())
  closedAt       DateTime?
  lostReason     String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  activities     Activity[]

  @@index([ventureKey, stage])
  @@index([nextActionDue])
  @@index([companyId])
}

// Everything that happens on a deal: outreach you sent, replies, calls, notes, and stage changes.
// The weekly funnel on the Today page is computed from these rows.
model Activity {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId  String?
  type       String                       // email_sent | linkedin_sent | reply | call | meeting | note | stage
  summary    String   @default("")
  meta       Json?                        // stage: { from, to }
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([dealId, occurredAt])
  @@index([type, occurredAt])
}

// A reusable "Hermes skill": a prompt template rendered with deal/company/contact context.
// Placeholders: {{deal.title}} {{company.name}} {{company.website}} {{company.industry}}
// {{company.size}} {{company.location}} {{contact.name}} {{contact.title}} {{contact.email}}
// {{notes}} {{input}}   (unknown placeholders render as empty)
model Playbook {
  key            String   @id
  ventureKey     String?
  venture        Venture? @relation(fields: [ventureKey], references: [key])
  name           String
  description    String   @default("")
  kind           String   @default("oneshot")  // AgentRequest kind → approval tier from lib/hermes-policy.ts
  promptTemplate String
  needsInput     Boolean  @default(false)      // ask the user for extra {{input}} when running
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
}

// ─── Hermes bus (Hermy HQ website ↔ Hermes on the Mac mini) ─────
// Shared Postgres is the message bus. A bridge on the mini polls
// AgentRequest, runs approved/safe ones via the `hermes` CLI, and
// mirrors kanban tasks + activity back into HermesTask / AgentEvent.

model AgentRequest {
  id            String    @id @default(cuid())
  origin        String    @default("web")     // "web" | "hermes"
  kind          String    @default("oneshot") // "oneshot" | "kanban" | "chat"
  title         String
  prompt        String?
  sideEffecting Boolean   @default(false)
  status        String    @default("queued")  // queued | awaiting_approval | approved | running | done | failed | rejected
  result        String?
  error         String?
  hermesTaskId  String?
  dealId        String?                       // set when a playbook run is attached to a deal
  playbookKey   String?
  decidedAt     DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([dealId])
}

model AgentEvent {
  id        String   @id @default(cuid())
  kind      String   @default("activity") // activity | run | status | memory
  title     String
  detail    String?
  agent     String?
  level     String   @default("info")     // info | up | warn | down
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model HermesTask {
  id        String   @id                   // Hermes task id
  board     String   @default("default")
  title     String
  assignee  String?
  status    String   @default("todo")
  priority  Int?
  result    String?
  updatedAt DateTime @default(now())
  syncedAt  DateTime @updatedAt

  @@index([board])
  @@index([status])
}

// ─── Hermes Memory Wiki (warm tier — git-tracked markdown, mirrored) ─────
model HermesMemory {
  id         String    @id            // wiki entry slug (relative path w/o .md)
  path       String                   // file path relative to wiki root
  type       String    @default("fact")
  title      String
  status     String    @default("active")
  confidence String?
  provenance String?
  tags       String[]
  links      String[]
  body       String    @default("")
  validFrom  DateTime?
  validTo    DateTime?
  updatedAt  DateTime  @default(now())
  syncedAt   DateTime  @updatedAt

  @@index([type])
  @@index([status])
}
