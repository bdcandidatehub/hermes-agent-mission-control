# ============================================================================
# Hermy HQ — environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# NEVER commit your real .env. The values below are FAKE placeholders — replace
# every one of them. When you deploy, set the same vars in your host (Vercel →
# Project → Settings → Environment Variables).
# ============================================================================


# ─── REQUIRED · Core ─────────────────────────────────────────────
# The dashboard will not run without these.

# Postgres connection string. This same database is the message bus shared
# with your Hermes bridge. Get one from Neon, Prisma Postgres, Supabase, or
# Vercel Postgres. Keep sslmode=require for hosted databases.
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"


# Public URL of the site. Use http://localhost:3000 locally, and your real
# domain in production (e.g. https://your-app.vercel.app).
NEXTAUTH_URL="http://localhost:3000"

# Secret used to sign NextAuth sessions. Generate one with:
#     openssl rand -base64 32
NEXTAUTH_SECRET="your-generated-secret"

# Google OAuth credentials for login. Create an OAuth 2.0 Client (type: Web)
# at https://console.cloud.google.com/apis/credentials and add the redirect
# URI:  <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Comma-separated allowlist of emails permitted to sign in. Anyone else is
# rejected even with a valid Google account.
ALLOWED_EMAILS="you@example.com,teammate@example.com"




# ─── Hermes / bridge ─────────────────────────────────────────────
# How the website coordinates with your local Hermes agent via the bridge.
# The bridge (hermes-bridge/) reads HERMES_* and DATABASE_URL on your machine;
# the website reads the shared ones below for scheduling and internal calls.

# Kanban board slug the bridge mirrors into HermesTask.
HERMES_BOARD="default"

# Path to the `hermes` CLI on the bridge machine, if it is not already on PATH.
HERMES_BIN="hermes"

# Hermes running in Docker? Point HERMES_BIN at hermes-bridge/hermes-docker.sh (absolute path); it runs
# `docker exec <container> hermes ...` (container name: HERMES_CONTAINER, default "hermes").

# Path to your Hermes memory-wiki root (git-tracked markdown) that the bridge
# mirrors into HermesMemory. Set on the bridge machine.
HERMES_WIKI="/path/to/hermes/wiki"

# IANA timezone used to decide what "today" means for follow-up due dates.
# APP_TZ="America/Halifax"

# Hour of day (0-23, local time) to generate the Chief-of-Staff daily brief.
BRIEF_HOUR="7"

# What the dashboard may write to the wiki: edit (default) | capture | readonly.
#   capture = compiled notes are read-only; "Add source" saves new notes into HERMES_RAW_DIR for your own ingest.
# HERMES_WIKI_MODE="capture"
# HERMES_RAW_DIR="/path/to/vault/Raw/Sources"   # default: <vault>/Raw/Sources when the wiki is inside an Obsidian vault

# Wiki mirroring: names NOT shown as memory entries (comma-separated, case-insensitive), and opt-in git commits.
# HERMES_WIKI_SKIP="Logs,index.md,INDEX.md"
# HERMES_WIKI_GIT="1"

# Agents page: Hermes' home directory on the bridge machine (holds config.yaml and profiles/<name>/config.yaml), used to
# show each agent's full model name. Optional. In Docker this is the folder mounted at /opt/data in the container.
# HERMES_DATA_DIR="/path/to/.hermes-docker"
# How long one direct agent chat turn may run (ms). Defaults to FRIDAY_TIMEOUT_MS.
# AGENT_TIMEOUT_MS="300000"

# Bridge tuning (all optional, set on the bridge machine).
# BRIDGE_POLL_MS="5000"           # how often to check for queued requests
# BRIDGE_MIRROR_MS="30000"        # how often to mirror kanban/cron/health/wiki to Postgres
# BRIDGE_RUN_TIMEOUT_MS="240000"  # max time for one Hermes run

# The bridge verifies your Postgres server's TLS certificate. Only if your provider uses a
# self-signed chain you can't trust, set PGSSL_INSECURE=1 (NOT recommended).
# PGSSL_INSECURE="1"

# Database on a private Docker network with no TLS (e.g. Coolify's internal Postgres, reached by IP from the host):
# PGSSL_DISABLE="1"

# Shared secret for machine-to-machine calls. Send it as the `x-internal-secret` header;
# src/middleware.ts accepts it in place of a login session. Treat it like a password: it
# grants access to every API route. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET="your-internal-api-secret"


# ─── Friday (talk to your chief of staff) ────────────────────────
# Voice: any OpenAI-compatible /v1/audio/speech server. `npm run tts:up` starts Kokoro on 127.0.0.1:8880.
# FRIDAY_TTS_URL="http://127.0.0.1:8880"
# FRIDAY_TTS_VOICE="bf_emma"        # British female: bf_emma bf_isabella bf_alice bf_lily · British male: bm_george bm_lewis bm_daniel
# FRIDAY_TTS_SPEED="1"
# Bridge: the Hermes session Friday's conversation lives in, and an optional faster model for chat only.
# FRIDAY_SESSION="hermy-dashboard"
# FRIDAY_MODEL=""
# How long the bridge waits for one Friday reply before giving up (ms). Default 300000 (5 min). A large
# remote model on a long conversation can take a while and grows slower as the session's history grows;
# raise this if turns start timing out, or set FRIDAY_MODEL to a faster model just for chat.
# FRIDAY_TIMEOUT_MS="300000"
